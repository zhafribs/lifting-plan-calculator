# Build output
/dist/
/src-tauri/target/
/src-tauri/target-ubuntu/

# Operator data: load-chart workbooks are not source
*.xlsx
*.pdf
# ...except the one example workbook the tests parse, and its source chart
!/docs/examples/*.xlsx
!/docs/examples/*.pdf

# Scratch (frontend fixture dumps, local test exports)
/ff16/

# The headless Chromium fetched for the PDF export (~128 MB, scripts/fetch-pdf-renderer.sh)
/src-tauri/pdf-renderer/chrome-headless-shell-linux64/

# Tauri generated schemas
/src-tauri/gen/schemas/

# Graphify knowledge graph: keep the built graph, ignore transient state
/graphify-out/cache/
/graphify-out/.graphify_*

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
