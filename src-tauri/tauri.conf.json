{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lifting Plan Calculator",
  "version": "2.17.2",
  "identifier": "com.zhafrisbs.liftingplancalculator",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lifting Plan Calculator",
        "width": 1440,
        "height": 950,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Utility",
    "publisher": "Zhafri Syazwi",
    "copyright": "Copyright © 2026 Zhafri Syazwi",
    "homepage": "https://github.com/zhafribs/lifting-plan-calculator",
    "license": "GPL-3.0-or-later",
    "shortDescription": "Lifting plan calculator for rigging and crane lifts",
    "longDescription": "Plan crane lifts: overall weight, crane capacity against an imported load chart, uniform and nonuniform sling arrangements, tandem lifts, and a printable calculation report.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../COPYRIGHT": "COPYRIGHT",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses": "licenses"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
