{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lifting Plan Calculator",
  "version": "2.0.0",
  "identifier": "com.zhafrisbs.liftingplancalculator",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lifting Plan Calculator",
        "width": 1440,
        "height": 950,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Lifting plan calculator for rigging and crane lifts",
    "longDescription": "Plan crane lifts: overall weight, crane capacity against an imported load chart, uniform and nonuniform sling arrangements, tandem lifts, and a printable calculation report.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
